    for _, item in pairs(cache) do
        if type(item) == "table" then
            for key, value in pairs(values) do
                if rawget(item, key) ~= nil then
                    if not _nrBackups[item] then _nrBackups[item] = {} end
                    if _nrBackups[item][key] == nil then
                        _nrBackups[item][key] = rawget(item, key)
                    end
                    pcall(function()
                        item[key] = value
                    end)
                end
            end
        end
    end
end

getgenv().__NR_APPLY = function()
    _nrBackups = {}
    applygc(getgc(true), _nrValues)
    print("[NoRecoil] ON")
end

getgenv().__NR_REMOVE = function()
    for item, data in pairs(_nrBackups) do
        for key, value in pairs(data) do
            pcall(function()
                item[key] = value
            end)
        end
    end
    _nrBackups = {}
    print("[NoRecoil] OFF")
end
