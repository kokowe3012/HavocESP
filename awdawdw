-- ================================================================
--  NO RECOIL (RAW — ห้าม obfus ส่วนนี้)
-- ================================================================
local Spread = {
    y = {[1] = 0, [2] = 0, [3] = 0},
    x = {[1] = 0, [2] = 0, [3] = 0},
    z = {[1] = 0, [2] = 0, [3] = 0},
}

local _nrValues = {
    vPunchBase   = 0,
    hPunchBase   = 0,
    spreadReduce = 100,
    spread       = Spread,
    vel          = 100000,
    weight       = 0,
    aimWeight    = 0,
    unAimWeight  = 0,
}

local _nrBackups = {}

local function _applyNoRecoil()
    _nrBackups = {}
    local n = 0
    for _, item in pairs(getgc(true)) do
        if type(item) == "table" then
            local backed = false
            for key, value in pairs(_nrValues) do
                if rawget(item, key) ~= nil then
                    if not backed then _nrBackups[item] = {}; backed = true end
                    _nrBackups[item][key] = rawget(item, key)
                    pcall(function() item[key] = value end)
                end
            end
            if backed then n = n + 1 end
        end
    end
    print("[NoRecoil] ON — tables:", n)
end

local function _removeNoRecoil()
    local n = 0
    for item, data in pairs(_nrBackups) do
        for key, value in pairs(data) do
            pcall(function() item[key] = value end)
        end
        n = n + 1
    end
    _nrBackups = {}
    print("[NoRecoil] OFF — restored:", n)
end

getgenv().__NR_APPLY  = _applyNoRecoil
getgenv().__NR_REMOVE = _removeNoRecoil
