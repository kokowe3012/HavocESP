local _gc = getgenv().__RGC  or getgc
local _rg = getgenv().__RGET or rawget
local _rs = getgenv().__RSET or rawset
local _tp = getgenv().__RTYP or type
local _nrBackups = {}

local function _applyNoRecoil()
    _nrBackups = {}
    local punchCount, statsCount = 0, 0
    for _, obj in ipairs(_gc(true)) do
        if _tp(obj) == "table" then
            if _rg(obj, "vPunchBase") ~= nil and _rg(obj, "hPunchBase") ~= nil then
                table.insert(_nrBackups, {tbl = obj, data = {
                    vPunchBase = _rg(obj, "vPunchBase"),
                    hPunchBase = _rg(obj, "hPunchBase"),
                }})
                _rs(obj, "vPunchBase", 0)
                _rs(obj, "hPunchBase", 0)
                punchCount = punchCount + 1
            elseif _rg(obj, "vel") ~= nil and _rg(obj, "spread") ~= nil and _rg(obj, "spreadReduce") ~= nil then
                local backup = {}
                for _, k in ipairs({"vel","spread","spreadReduce","aimWeight","unAimWeight","recoil"}) do
                    backup[k] = _rg(obj, k)
                end
                table.insert(_nrBackups, {tbl = obj, data = backup})
                _rs(obj, "spreadReduce", 100)
                _rs(obj, "vel", 100000)
                if _rg(obj, "aimWeight") ~= nil then _rs(obj, "aimWeight", 0) end
                if _rg(obj, "unAimWeight") ~= nil then _rs(obj, "unAimWeight", 0) end
                statsCount = statsCount + 1
            end
        end
    end
    print("[NoRecoil] ON — punch:", punchCount, "| stats:", statsCount)
end

local function _removeNoRecoil()
    for _, entry in ipairs(_nrBackups) do
        for k, v in pairs(entry.data) do
            _rs(entry.tbl, k, v)
        end
    end
    print("[NoRecoil] OFF — คืนค่า", #_nrBackups, "tables")
    _nrBackups = {}
end

getgenv().__NR_APPLY  = _applyNoRecoil
getgenv().__NR_REMOVE = _removeNoRecoil
