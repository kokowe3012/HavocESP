local _nrBackups = {}

local function _applyNoRecoil()
    _nrBackups = {}
    local punchCount, statsCount = 0, 0
    for _, obj in ipairs(getgc(true)) do
        if type(obj) == "table" then
            if rawget(obj, "vPunchBase") ~= nil and rawget(obj, "hPunchBase") ~= nil then
                table.insert(_nrBackups, {tbl = obj, data = {
                    vPunchBase = rawget(obj, "vPunchBase"),
                    hPunchBase = rawget(obj, "hPunchBase"),
                }})
                rawset(obj, "vPunchBase", 0)
                rawset(obj, "hPunchBase", 0)
                punchCount = punchCount + 1
            elseif rawget(obj, "vel") ~= nil and rawget(obj, "spread") ~= nil and rawget(obj, "spreadReduce") ~= nil then
                local backup = {}
                for _, k in ipairs({"vel","spread","spreadReduce","aimWeight","unAimWeight","recoil"}) do
                    backup[k] = rawget(obj, k)
                end
                table.insert(_nrBackups, {tbl = obj, data = backup})
                rawset(obj, "spreadReduce", 100)
                rawset(obj, "vel", 100000)
                if rawget(obj, "aimWeight") ~= nil then rawset(obj, "aimWeight", 0) end
                if rawget(obj, "unAimWeight") ~= nil then rawset(obj, "unAimWeight", 0) end
                statsCount = statsCount + 1
            end
        end
    end
    print("[NoRecoil] ON — punch:", punchCount, "| stats:", statsCount)
end

local function _removeNoRecoil()
    for _, entry in ipairs(_nrBackups) do
        for k, v in pairs(entry.data) do
            rawset(entry.tbl, k, v)
        end
    end
    print("[NoRecoil] OFF — คืนค่า", #_nrBackups, "tables")
    _nrBackups = {}
end

getgenv().__NR_APPLY  = _applyNoRecoil
getgenv().__NR_REMOVE = _removeNoRecoil
