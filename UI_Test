-- ทดสอบ HAVOC_UI redesign (sidebar/3-column/ColorPicker/SubTab/Logo)
-- ⚠ แก้ URL ด้านล่างให้ชี้ path ทดสอบ (ไม่ใช่ Havoc_UI ตัวจริง) ก่อนรัน
local UI_TEST_URL = "https://raw.githubusercontent.com/kokowe3012/HavocESP/refs/heads/main/UI_Test"

local ok, Lib = pcall(function()
    return loadstring(game:HttpGet(UI_TEST_URL .. "?v=" .. tostring(tick())))()
end)
if not ok or not Lib then
    warn("โหลด lib ไม่สำเร็จ: " .. tostring(Lib))
    return
end

local Win = Lib:CreateWindow({
    Name = "HAVOC_UI_TEST",
    Title = "Terdsak",
    Sub = "Redesign Preview",
    Version = "1.0.0",
    LockMouse = false,
    -- LogoImage = "rbxassetid://0",  -- ใส่ asset id หลังอัพโหลดโลโก้จริง
})

-- ── Tab 1: ทดสอบ 3-column grid + component ทุกชนิด ──────────────
local mainTab = Win:CreateTab("Combat", { Icon = "combat" })

local c1 = mainTab:CreateCard("Main", { Column = 1 })
c1:Toggle({ Name = "Enabled", Default = true, Bind = true, BindDefault = Enum.KeyCode.E,
    Callback = function(v) print("Enabled:", v) end })
c1:Toggle({ Name = "Visible Check", Default = false, Callback = function(v) print("Visible:", v) end })
c1:Slider({ Name = "Distance", Min = 0, Max = 1000, Default = 500, Suffix = "st",
    Callback = function(v) print("Distance:", v) end })
c1:Input({ Name = "FOV", Default = 90, Min = 10, Max = 180 })

local c2 = mainTab:CreateCard("Exploits", { Column = 2 })
c2:Toggle({ Name = "Manipulation", Default = false })
c2:Slider({ Name = "Points", Min = 0, Max = 100, Default = 10 })
c2:Dropdown({ Name = "Mode", Options = { "Silent Aim", "Legit", "Assist" }, Multi = false,
    Default = { "Silent Aim" }, Callback = function(_, list) print("Mode:", list[1]) end })

local c3 = mainTab:CreateCard("Visuals", { Column = 3 })
c3:Toggle({ Name = "FOV Circle", Default = true })
c3:ColorPicker({ Name = "FOV Color", Default = Color3.fromRGB(255, 140, 0),
    Callback = function(c) print("Color:", c) end })
c3:ColorPicker({ Name = "Crosshair", Default = "#FF3B3B" })
c3:TextInput({ Name = "Tag", Default = "", Placeholder = "custom text" })
c3:Button({ Name = "Test Button", Callback = function() Win:Notify("Button clicked") end })

-- ── Tab 2: ทดสอบ Sub-Tab (แถบแนวนอนในแท็บเดียว) ──────────────
local subDemo = Win:CreateTab("Visuals", { Icon = "eye" })
local sub1 = subDemo:CreateSubTab("Players")
sub1:CreateCard("Player ESP", { Column = 1 }):Toggle({ Name = "Enabled", Default = true })
local sub2 = subDemo:CreateSubTab("World")
sub2:CreateCard("World ESP", { Column = 1 }):Toggle({ Name = "Enabled", Default = false })

-- ── Tab 3: ว่าง ทดสอบ icon เฉยๆ ──────────────
Win:CreateTab("Settings", { Icon = "settings" })

-- ── ปุ่ม Delete — ทดสอบเสร็จกด destroy ตัวเองทิ้ง (ตามกฎ test script ทุกตัวต้องมี) ──
local delCard = mainTab:CreateCard("Test Controls", { Column = 1 })
delCard:Button({ Name = "Delete Test UI", Danger = true, Callback = function()
    Win:Destroy()
end })

Win:Notify("UI redesign test loaded")
