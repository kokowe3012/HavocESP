var SHEET_NAME     = "Havoc";
var SPREADSHEET_ID = "1AMHqgYjdR0MABOGp7Ki999M6aWhXuP3730UQuHqOKlQ";
var SECRET         = "H@v0c!ESP#2026$xKq9";

// Columns: key | hwid | created_at | expires_at | premium | day | hour | source
var COL_KEY        = 1;
var COL_HWID       = 2;
var COL_CREATED_AT = 3;
var COL_EXPIRES_AT = 4;
var COL_PREMIUM    = 5;
var COL_DAY        = 6;
var COL_HOUR       = 7;
var COL_SOURCE     = 8;

// ── Security ─────────────────────────────────────────────────────
function fnvSign(payload) {
  var h = 2166136261;
  for (var i = 0; i < payload.length; i++) {
    h = Math.imul(h, 16777619) >>> 0;
    h = (h + payload.charCodeAt(i)) >>> 0;
  }
  return h.toString(16).padStart(8, "0");
}

function checkSignature(key, hwid, ts, sig) {
  var nowWindow = Math.floor(Date.now() / 1000 / 300);
  var reqWindow = parseInt(ts) || 0;
  if (Math.abs(nowWindow - reqWindow) > 1) return "expired";
  if (fnvSign(key + hwid + ts + SECRET) !== sig) return "invalid";
  return "ok";
}

function rateLimitCheck(hwid) {
  var cache  = CacheService.getScriptCache();
  var rlKey  = "rl_" + hwid;
  var count  = parseInt(cache.get(rlKey) || "0");
  if (count >= 10) return false;
  cache.put(rlKey, (count + 1).toString(), 60);
  return true;
}

// ── Main ─────────────────────────────────────────────────────────
function doGet(e) {
  var action = (e.parameter.action || "").toLowerCase();
  var result;

  if (action === "verify") {
    var key  = e.parameter.key  || "";
    var hwid = e.parameter.hwid || "";
    var ts   = e.parameter.ts   || "";
    var sig  = e.parameter.sig  || "";

    var sigCheck = checkSignature(key, hwid, ts, sig);
    if (sigCheck === "expired") {
      result = { valid: false, message: "Request expired" };
    } else if (sigCheck === "invalid") {
      result = { valid: false, message: "Invalid request" };
    } else if (!rateLimitCheck(hwid)) {
      result = { valid: false, message: "Too many requests, please wait." };
    } else {
      result = verify(key, hwid);
    }
  } else if (action === "addkey") {
    var adminSig = e.parameter.adminsig || "";
    if (fnvSign("addkey" + SECRET) !== adminSig) {
      result = { success: false, message: "Unauthorized" };
    } else {
      var newKey  = e.parameter.newkey || randomKey(16);
      var premium = true;
      var day     = parseInt(e.parameter.day) || 0;
      var hour    = parseInt(e.parameter.hour) || 24;
      var source  = e.parameter.source || "";
      getSheet().appendRow([newKey, "", "", "", premium, day, hour, source]);
      result = { success: true, key: newKey };
    }
  } else if (action === "resethwid") {
    var adminSig = e.parameter.adminsig || "";
    if (fnvSign("resethwid" + SECRET) !== adminSig) {
      result = { success: false, message: "Unauthorized" };
    } else {
      var targetKey = e.parameter.key || "";
      result = resetHwid(targetKey);
    }
  } else {
    result = { error: "Unknown action" };
  }

  return ContentService
    .createTextOutput(JSON.stringify(result))
    .setMimeType(ContentService.MimeType.JSON);
}

// ── Verify ───────────────────────────────────────────────────────
function verify(key, hwid) {
  if (!key || !hwid) return { valid: false, message: "Missing key or hwid" };
  var sheet = getSheet();
  var data  = sheet.getDataRange().getValues();

  for (var i = 1; i < data.length; i++) {
    var row = data[i];
    if (String(row[COL_KEY - 1]) !== String(key)) continue;

    var storedHwid = row[COL_HWID - 1] ? String(row[COL_HWID - 1]) : "";
    var expiresStr = row[COL_EXPIRES_AT - 1] ? String(row[COL_EXPIRES_AT - 1]) : "";
    var isPremium  = row[COL_PREMIUM - 1] === true || String(row[COL_PREMIUM - 1]).toUpperCase() === "TRUE";
    var customDay  = Number(row[COL_DAY - 1]) || 0;
    var customHour = Number(row[COL_HOUR - 1]);
    if (isNaN(customHour)) customHour = 24;

    var now = new Date();

    // First use: activate key + lock HWID + set expiry
    if (expiresStr === "") {
      var exp = new Date(now.getTime() + (customDay * 24 + customHour) * 3600 * 1000);
      sheet.getRange(i + 1, COL_HWID).setValue(hwid);
      sheet.getRange(i + 1, COL_CREATED_AT).setValue(toThai(now));
      sheet.getRange(i + 1, COL_EXPIRES_AT).setValue(toThai(exp));
      return { valid: true, premium: isPremium, message: "Key activated!" };
    }

    // Expired
    if (new Date() > parseThai(expiresStr)) {
      return { valid: false, expired: true, message: "Key expired. Renew at Discord." };
    }

    // No HWID yet (shouldn't happen but handle)
    if (storedHwid === "") {
      sheet.getRange(i + 1, COL_HWID).setValue(hwid);
      return { valid: true, premium: isPremium, message: "OK" };
    }

    // Wrong device
    if (storedHwid !== hwid) {
      return { valid: false, message: "Key is locked to another device." };
    }

    // All good
    return { valid: true, premium: isPremium, message: "OK" };
  }

  return { valid: false, message: "Invalid key" };
}

// ── Reset HWID ───────────────────────────────────────────────────
function resetHwid(key) {
  if (!key) return { success: false, message: "No key provided" };
  var sheet = getSheet();
  var data  = sheet.getDataRange().getValues();

  for (var i = 1; i < data.length; i++) {
    if (String(data[i][COL_KEY - 1]) !== String(key)) continue;
    sheet.getRange(i + 1, COL_HWID).setValue("");
    return { success: true, message: "HWID reset for key: " + key };
  }
  return { success: false, message: "Key not found" };
}

// ── Thai time helper (UTC+7) ─────────────────────────────────────
function toThai(date) {
  var thai = new Date(date.getTime() + 7 * 3600 * 1000);
  var d = thai.getUTCDate().toString().padStart(2, "0");
  var m = (thai.getUTCMonth() + 1).toString().padStart(2, "0");
  var y = thai.getUTCFullYear();
  var hh = thai.getUTCHours().toString().padStart(2, "0");
  var mm = thai.getUTCMinutes().toString().padStart(2, "0");
  return d + "/" + m + "/" + y + " " + hh + ":" + mm;
}

function parseThai(str) {
  if (!str) return null;
  str = String(str);
  // ISO format fallback
  if (str.indexOf("T") > -1) return new Date(str);
  // dd/mm/yyyy hh:mm
  var parts = str.match(/(\d+)\/(\d+)\/(\d+)\s+(\d+):(\d+)/);
  if (!parts) return new Date(str);
  var utc = Date.UTC(Number(parts[3]), Number(parts[2]) - 1, Number(parts[1]), Number(parts[4]) - 7, Number(parts[5]));
  return new Date(utc);
}

// ── Sheet helper ─────────────────────────────────────────────────
function getSheet() {
  var ss    = SpreadsheetApp.openById(SPREADSHEET_ID);
  var sheet = ss.getSheetByName(SHEET_NAME);
  if (!sheet) {
    sheet = ss.insertSheet(SHEET_NAME);
  }
  var firstCell = sheet.getRange(1, 1).getValue();
  if (!firstCell || String(firstCell) !== "key") {
    sheet.getRange(1, 1, 1, 8).setValues([["key", "hwid", "created_at", "expires_at", "premium", "day", "hour", "source"]]);
    var hdr = sheet.getRange(1, 1, 1, 8);
    hdr.setFontWeight("bold");
    hdr.setBackground("#1a1a2e");
    hdr.setFontColor("#ffffff");
    sheet.setFrozenRows(1);
    sheet.setColumnWidths(1, 8, 200);
  }
  return sheet;
}

function randomKey(len) {
  var chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
  var result = "";
  for (var i = 0; i < len; i++) {
    if (i > 0 && i % 4 === 0) result += "-";
    result += chars.charAt(Math.floor(Math.random() * chars.length));
  }
  return result;
}
